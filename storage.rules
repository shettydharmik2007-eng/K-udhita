rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Food listing photos
    match /foodListings/{allPaths=**} {
      // Anyone can view uploaded food photos
      allow read: if true;
      // Only authenticated users can upload food photos (under 5MB, image MIME type)
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
